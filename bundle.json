{
    "name": "@ohos/libhybris",
    "description": "libhybris allows to use bionic-based HW adaptations in glibc systems",
    "version": "3.0",
    "license": "Apache-2.0 AND BSD-2-Clause AND ISC AND MIT",
    "publishAs": "code-segment",
    "segment": {
        "destPath": "third_party/libhybris"
    },
    "dirs": {},
    "scripts": {},
    "component": {
        "name": "libhybris",
        "subsystem": "thirdparty",
        "syscap": [],
        "features": [
            "libhybris_enable_wayland"
        ],
        "adapted_system_type": [],
        "rom": "",
        "ram": "",
        "deps": {
            "components": [
                "c_utils",
                "graphic_surface",
                "hilog",
                "wayland"
            ],
            "third_party": []
        },
        "build": {
            "sub_component": [
                "//third_party/libhybris:libhybris",
                "//third_party/libhybris/hybris/egl/platforms/ohos:eglplatform_ohos"
            ],
            "inner_kits": [
                {
                    "header": {
                        "header_base": "//third_party/libhybris/hybris/platforms/common",
                        "header_files": [
                            "server_wlegl.h",
                            "server_wlegl_buffer.h",
                            "windowbuffer.h"
                        ]
                    },
                    "name": "//third_party/libhybris/hybris/platforms:libhybris-platformcommon"
                }
            ],
            "test": []
        }
    }
}
